# ── Env files ───────────────────────────────────────────────────
# scripts/load-env.js loads two files in this order:
#
#   1. .env.production — production config. Committed to git,
#      fully encrypted (dotenvx) except PORT/TLS_* below.
#      Contributors/forks: ignore this file — you cannot decrypt it,
#      and builds must never use someone else's identity.
#   2. .env            — YOUR personal env (gitignored). Values here
#      override .env.production. Bun (serve.ts) also loads both via
#      the same loader.
#
# Getting started as a contributor:
#   cp .env.example .env    # then fill in your own values

# ── Extension Configuration ── set your OWN values in .env
TARGET_HOST=""
CHROME_EXTENSION_KEY=""
FIREFOX_EXTENSION_ID=""

# ── Firefox AMO Signing ── your own AMO credentials go here.
# Production values are stored encrypted in .env.production.
AMO_JWT_ISSUER=""
AMO_JWT_SECRET=""

# ── Server ── these stay in local .env (plaintext defaults).
# PORT/TLS_* have hardcoded fallbacks in serve.ts even if absent.
# HOST also has a 'localhost' default — needed only if you want
# a non-default hostname for the update_url fallback (PUBLIC_URL
# takes priority when set).
HOST="localhost"
PORT="3000"
# PUBLIC_URL="https://your-domain.com"  # encrypted in .env.production; duplicate here if needed
TLS_CERT="keys/localhost.pem"
TLS_KEY="keys/localhost-key.pem"
