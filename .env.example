# ── Env files ───────────────────────────────────────────────────
# scripts/load-env.js loads two files in this order:
#
#   1. .env.production — OWNER'S production config. Committed to git
#      but FULLY ENCRYPTED (dotenvx) except PORT/TLS_* below.
#      Contributors/forks: ignore this file — you cannot decrypt it,
#      and builds must never inherit the owner's identity.
#   2. .env            — YOUR personal env (gitignored). Values here
#      override .env.production. Bun (serve.ts) reads this natively.
#
# Getting started as a contributor:
#   cp .env.example .env    # then fill in your own values

# ── Extension Configuration ── set your OWN values in .env
TARGET_HOST=""
CHROME_EXTENSION_KEY=""
FIREFOX_EXTENSION_ID=""

# ── Firefox AMO Signing ── your own AMO credentials in .env;
# the owner keeps these ENCRYPTED in .env.production via dotenvx:
#   pnpm exec dotenvx set -f .env.production AMO_JWT_ISSUER "<value>"
#   pnpm exec dotenvx set -f .env.production AMO_JWT_SECRET "<value>"
AMO_JWT_ISSUER=""
AMO_JWT_SECRET=""

# ── Server ── local .env only (Bun never decrypts .env.production).
# PORT/TLS_* are the only values that stay plaintext even in the
# owner's .env.production. HOST/PUBLIC_URL are encrypted there and
# must be duplicated here (plaintext) for the server to see them.
HOST="localhost"
PORT="3000"
# PUBLIC_URL="https://your-domain.com"
TLS_CERT="keys/localhost.pem"
TLS_KEY="keys/localhost-key.pem"
