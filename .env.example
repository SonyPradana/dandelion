# ── Extension Configuration ──
TARGET_HOST=""
CHROME_EXTENSION_KEY=""
FIREFOX_EXTENSION_ID=""

# ── Chrome CRX Signing ──
# Optional override for the PEM key used to sign the CRX in `pnpm crx:chrome`.
# Defaults to keys/development.pem.
# CRX_KEY_PATH="keys/development.pem"

# ── Firefox AMO Signing ──
AMO_JWT_ISSUER=""
AMO_JWT_SECRET=""

# ── Server ──
HOST="localhost"
PORT="3000"
# PUBLIC_URL="https://your-domain.com" # override for tunnel / reverse proxy
TLS_CERT="keys/localhost.pem"
TLS_KEY="keys/localhost-key.pem"
